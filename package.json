    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "react-phone-number-input": "^3.4.12",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.1",
    "redux-persist": "^6.0.0",
    "zustand": "^5.0.5"
